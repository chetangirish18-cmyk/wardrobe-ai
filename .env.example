# Session security
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Production: set this to the Render Postgres Internal Database URL.
# Local development: leave blank to use wardrobe.db (SQLite).
DATABASE_URL=

# Optional persistent upload location. Example on a paid Render disk: /var/data/uploads
UPLOAD_DIR=

# No OTP/Twilio configuration is required.
# WARDROBE uses mobile number + password authentication.

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
