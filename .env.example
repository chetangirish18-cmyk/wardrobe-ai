# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Set true when the app is served over HTTPS.
COOKIE_SECURE=false

# No OTP/Twilio configuration is required.
# WARDROBE uses mobile number + password authentication.

# Optional Telegram integration from the earlier version
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
